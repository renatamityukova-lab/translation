# Шаблон переменных окружения. Скопируйте в .env и заполните значения.
#   copy .env.example .env        (Windows cmd)
#   cp .env.example .env          (bash)

# API-ключ LLM (обязательно)
OPENAI_API_KEY=your_api_key_here

# Параметры LLM (переопределяют config/config.yaml)
LLM_PROVIDER=openai
LLM_MODEL=gpt-oss-120b
LLM_FALLBACK_MODEL=MiniMax-M2.7
LLM_BASE_URL=https://llm.enplus.group/v1
LLM_FALLBACK_BASE_URL=
LLM_TRUST_ENV=true

# Параметры кеша
CACHE_ENABLED=true
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=86400
CACHE_MAX_SIZE=10000

# Логирование (переопределяет config/config.yaml)
LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_FILE=true
LOG_FILE_PATH=logs/transtalion.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
